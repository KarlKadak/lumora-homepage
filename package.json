{
  "name": "lumora-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "tsc:check": "tsc --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "prettier:fix": "prettier --list-different --write '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "check": "chmod +x ./scripts/check.sh && ./scripts/check.sh",
    "fix": "chmod +x ./scripts/fix.sh && ./scripts/fix.sh"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "16.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-sort-json": "^4.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.71.0"
  }
}
